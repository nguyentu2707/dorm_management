PORT=3000
DATABASE_URL=postgresql://dormitory:change-local-password@127.0.0.1:5432/dormitory_management
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated explicit browser origins allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_FULL_NAME=Quản trị viên
# Use a separate disposable DB for integration tests; never point this at development data.
TEST_DATABASE_URL=postgresql://dormitory:change-local-password@127.0.0.1:5432/dormitory_test
# Only used by docker compose, not by application runtime.
POSTGRES_PASSWORD=change-local-password
