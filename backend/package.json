{
  "name": "dormitory-management-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix ../frontend run build && npm run build && node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/server.js",
    "seed:admin": "npm run build && node scripts/seeds/seed-admin.mjs",
    "seed:dormitory": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/seeds/seed-dormitory-data.js",
    "test:recommendation": "npm run build && node --test tests/room-recommendation.test.mjs",
    "test:room-change": "npm run build && node --test tests/room-change-request.test.mjs",
    "test:core": "npm run build && node --test tests/*.test.mjs",
    "seed:demo-students": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/seeds/seed-demo-students.js",
    "db:migrate": "node scripts/database/migrate.mjs up",
    "db:migrate:test": "node scripts/testing/migrate-test.mjs",
    "db:rollback": "node scripts/database/migrate.mjs down",
    "test:postgres": "npm run build && node scripts/testing/run-postgres-tests.mjs",
    "db:check": "node scripts/database/check-connection.mjs",
    "db:audit": "node scripts/audit/audit-postgres.mjs",
    "db:audit:room-capacity": "node scripts/audit/audit-room-capacity.mjs",
    "db:erd": "node scripts/audit/schema-to-erd.mjs",
    "db:backfill:contract-prices": "node scripts/database/backfill-contract-room-price.mjs",
    "smoke:ui-api": "npm run build && node scripts/testing/smoke-ui-api.mjs",
    "smoke:postgres": "npm run build && node scripts/testing/smoke-postgres.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
