{
  "name": "dormitory-management-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix ../frontend run build && npm run build && node dist/server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:admin": "npm run build && node scripts/seed-admin.mjs",
    "seed:dormitory": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/seed-dormitory-data.js",
    "reset:dormitory": "node scripts/reset-dormitory-data.mjs && npm run seed:dormitory"
    ,"test:recommendation": "npm run build && node --test tests/room-recommendation.test.mjs",
    "seed:demo-students": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/seed-demo-students.js"
    ,"db:init-replica": "node scripts/init-replica-set.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
