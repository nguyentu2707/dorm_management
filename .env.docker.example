# Copy this file to .env before running Docker Compose.
POSTGRES_DB=dormitory_management
POSTGRES_USER=dormitory
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Use two different random values, each at least 32 characters.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

APP_PORT=3000
APP_ORIGIN=http://localhost:3000

# Keep development for local HTTP. Set production only when APP_ORIGIN uses
# HTTPS, because production refresh-token cookies are marked Secure.
NODE_ENV=development

# Used only when manually creating the initial administrator account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME=Quản trị viên
